{
  "name": "exopulse",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i assets/styles/app.css -o public/build/app.css --minify && esbuild assets/app.js --bundle --minify --outfile=public/build/app.js",
    "check": "for file in assets/*.js assets/controllers/*.js; do node --check \"$file\" || exit 1; done"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0"
  }
}
