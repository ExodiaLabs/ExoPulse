# Safe development defaults. Override secrets in .env.local or the environment.
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080
DATABASE_URL="postgresql://exopulse:exopulse@127.0.0.1:5432/exopulse?serverVersion=17&charset=utf8"
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"
LOCK_DSN=flock
# Authentication remains disabled until a password hash is configured.
ADMIN_IDENTIFIER=admin
ADMIN_PASSWORD_HASH=
