<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ExoPulse{% endblock %} · Exodia</title>
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    <script src="{{ asset('build/app.js') }}" defer></script>
</head>
<body data-controller="theme">
<a href="#main" class="exo-btn exo-skip">Aller au contenu</a>
{% block layout %}
<div class="exo-layout min-h-screen md:flex">
    {% include 'components/sidebar.html.twig' %}
    <main id="main" class="exo-main min-w-0 flex-1 p-4 md:p-7" tabindex="-1">
        <header class="exo-page-header mb-7 flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="exo-eyebrow">EXODIA / EXOPULSE</p>
                <h1 class="mt-1 text-3xl font-extrabold">{% block page_title %}Tableau de bord{% endblock %}</h1>
                <p class="mt-2 text-sm text-muted">{% block page_subtitle %}Gardez le pouls de votre parc applicatif.{% endblock %}</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">{% block page_actions %}{% endblock %}{% include 'components/theme_toggle.html.twig' %}</div>
        </header>
        {% for type,messages in app.flashes %}
            {% for message in messages %}<div class="exo-flash exo-card mb-4 p-4 {{ type == 'error' ? 'text-danger' : 'text-success' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>{% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
        <footer class="mt-7 text-xs text-muted">ExoPulse · Supervision de la santé technique du parc applicatif</footer>
    </main>
</div>
{% endblock %}
</body>
</html>
