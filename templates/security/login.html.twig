{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block navigation_meta %}<meta name="turbo-visit-control" content="reload">{% endblock %}
{% block layout %}
<main id="main" class="mx-auto flex min-h-screen max-w-md flex-col justify-center gap-6 px-5 py-10" tabindex="-1">
    <div class="flex items-center justify-between gap-3">
        <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 text-2xl font-extrabold"><span class="exo-gradient rounded-lg p-2 text-white" aria-hidden="true">◆</span>ExoPulse</a>
        {% include 'components/theme_toggle.html.twig' %}
    </div>
    <section class="exo-card p-7" aria-labelledby="login-title">
        <p class="exo-eyebrow">EXODIA / ESPACE SÉCURISÉ</p>
        <h1 id="login-title" class="mt-2 text-2xl font-extrabold">Connexion</h1>
        <p class="mt-2 text-sm text-muted">Gardez le pouls de votre parc applicatif.</p>
        {% if error %}<p id="login-error" class="mt-5 rounded-control border border-danger p-3 text-sm text-danger" role="alert">Identifiants incorrects ou connexion impossible. Réessayez.</p>{% endif %}
        <form data-turbo="false" action="{{ path('app_login') }}" method="post" class="mt-6 space-y-5"{% if error %} aria-describedby="login-error"{% endif %}>
            <div>
                <label for="username" class="mb-2 block text-sm font-semibold">Identifiant</label>
                <input id="username" name="_username" value="{{ last_username }}" class="exo-input" autocomplete="username" required autofocus>
            </div>
            <div>
                <label for="password" class="mb-2 block text-sm font-semibold">Mot de passe</label>
                <input id="password" name="_password" type="password" class="exo-input" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="exo-btn w-full">Se connecter</button>
        </form>
    </section>
</main>
{% endblock %}
