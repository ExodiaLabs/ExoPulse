{% extends 'base.html.twig' %}
{% block title %}Connexions{% endblock %}
{% block page_title %}Connexions fournisseurs{% endblock %}
{% block page_subtitle %}Reliez vos plateformes Git et gardez la maîtrise du périmètre analysé.{% endblock %}
{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <p class="exo-kicker">VOS SOURCES DE DONNÉES</p>
            <p class="mt-1 text-sm text-muted">{{ connections|length }} connexion(s) configurée(s) · GitHub et GitLab</p>
        </div>
        <a class="exo-btn" href="{{ path('app_connection_new') }}"><span aria-hidden="true">＋</span> Ajouter une connexion</a>
    </div>

    {% set states = {untested:'À vérifier',connected:'Connexion vérifiée',failed:'Échec de connexion',error:'Erreur de synchronisation',syncing:'Synchronisation en cours'} %}
    <section class="grid gap-5 xl:grid-cols-2" aria-label="Connexions configurées">
        {% for connection in connections %}
            <article class="exo-card overflow-hidden">
                <div class="border-b border-line p-5 sm:p-6">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="exo-kicker">{{ connection.provider == 'github' ? 'GitHub' : 'GitLab' }}</p>
                            <h2 class="mt-2 text-xl font-bold"><a class="hover:text-primary" href="{{ path('app_connection',{id:connection.id}) }}">{{ connection.name }}</a></h2>
                            <p class="mt-2 break-all text-sm text-muted">{{ connection.baseUrl }}</p>
                        </div>
                        <span class="exo-badge {{ connection.active ? 'text-success' : 'text-muted' }}">{{ connection.active ? 'Active' : 'Désactivée' }}</span>
                    </div>
                    <p class="mt-4 flex items-center gap-2 text-sm {{ connection.status in ['failed','error'] ? 'text-danger' : (connection.status == 'connected' ? 'text-success' : 'text-muted') }}">
                        <span aria-hidden="true">●</span> {{ states[connection.status]|default(connection.status) }}
                    </p>
                    {% if connection.lastError %}<p class="mt-3 rounded-lg border border-line bg-canvas p-3 text-sm text-danger">{{ connection.lastError }}</p>{% endif %}
                </div>
                <div class="p-5 sm:p-6">
                    <dl class="grid gap-4 text-sm sm:grid-cols-2">
                        <div><dt class="text-muted">Dernière synchronisation</dt><dd class="mt-1 font-semibold">{{ connection.lastSyncedAt ? connection.lastSyncedAt|date('d/m/Y à H:i') : 'Pas encore synchronisée' }}</dd></div>
                        <div><dt class="text-muted">Fréquence</dt><dd class="mt-1 font-semibold">Toutes les {{ connection.frequencyHours }} heures</dd></div>
                        <div class="sm:col-span-2"><dt class="text-muted">Organisations ou groupes</dt><dd class="mt-1 break-words">{{ connection.organizations|join(', ') ?: 'Tous les repositories accessibles au jeton' }}</dd></div>
                    </dl>
                    <a class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-primary" href="{{ path('app_connection',{id:connection.id}) }}">Gérer la connexion <span aria-hidden="true">→</span></a>
                </div>
            </article>
        {% else %}
            <div class="exo-card exo-empty col-span-full p-6 sm:p-10">
                {% include 'components/empty_state.html.twig' with {title:'Connectez votre première plateforme Git',message:'Ajoutez une connexion GitHub ou GitLab avec un jeton aux permissions minimales pour découvrir vos repositories.'} only %}
                <p class="mx-auto max-w-lg text-center text-sm text-muted">Chaque connexion dispose de son propre jeton et de son propre périmètre. Vous pouvez connecter plusieurs instances d’un même fournisseur.</p>
            </div>
        {% endfor %}
    </section>
{% endblock %}
