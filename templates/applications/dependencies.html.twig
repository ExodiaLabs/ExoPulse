{% extends 'base.html.twig' %}
{% block title %}Dépendances{% endblock %}
{% block page_title %}Dépendances · {{ repository.name }}{% endblock %}
{% block page_subtitle %}Versions observées, support des technologies et dette des mises à jour.{% endblock %}
{% block body %}
    {% if repository.id is defined %}<nav class="mb-5 flex flex-wrap gap-3" aria-label="Application"><a class="exo-btn exo-btn-alt" href="{{ path('app_application',{id:repository.id}) }}">← Détail de l’application</a><a class="exo-btn exo-btn-alt" href="{{ path('app_application_history',{id:repository.id}) }}">Historique des analyses</a></nav>{% endif %}
    {% set diagnostic = diagnostic|default(repository.id is defined ? diagnostics[repository.id]|default(null) : null) %}
    {% if diagnostic %}
        <section class="exo-card mb-5 p-5" aria-label="Diagnostic technique">
            <div class="exo-section-heading"><h2>Obsolescence et risque technique</h2></div>
            {% include 'components/technical_diagnostic.html.twig' with {diagnostic:diagnostic} only %}
        </section>
    {% endif %}
    <section class="exo-card p-5">
        <div class="exo-section-heading"><h2>Technologies et versions détectées</h2></div>
        <p class="mb-5 text-sm leading-relaxed text-muted">La version déclarée exprime une intention ou une contrainte. Une version résolue est relevée dans le repository ; elle ne prouve pas la version installée en production. Une information inconnue ne permet pas de conclure que la technologie est maintenue.</p>
        {% if scan %}
            <p class="mb-5 text-xs text-muted">Analyse du {{ scan.createdAt is defined ? scan.createdAt|date('d/m/Y H:i') : 'Date inconnue' }} · Confiance {{ scan.confidence is defined ? scan.confidence ~ ' %' : 'inconnue' }} · Couverture {{ scan.coverage is defined ? scan.coverage ~ ' %' : 'inconnue' }}</p>
            <div class="grid gap-4 lg:grid-cols-2">
                {% for technology in scan.results.technologies|default([]) %}
                    <article class="min-w-0 rounded-xl border border-line p-4">
                        <h3 class="break-words font-bold">{{ technology.name|default(technology.technology|default('Technologie')) }}</h3>
                        <dl class="mt-4 grid min-w-0 gap-3 text-sm sm:grid-cols-2">
                            <div><dt class="text-muted">Version déclarée</dt><dd class="mt-1 font-semibold">{{ technology.declared|default('Inconnue',true) }}</dd></div>
                            <div><dt class="text-muted">Version résolue</dt><dd class="mt-1 font-semibold">{{ technology.resolved|default('Inconnue',true) }}</dd></div>
                            <div><dt class="text-muted">Fin de maintenance active</dt><dd class="mt-1">{{ technology.endOfMaintenance|default('Inconnue',true) }}</dd></div>
                            <div><dt class="text-muted">Fin de support</dt><dd class="mt-1">{{ technology.eol|default('Inconnue',true) }}</dd></div>
                            <div><dt class="text-muted">Source de la version</dt><dd class="mt-1 [overflow-wrap:anywhere]">{{ technology.source|default('Indisponible',true) }}</dd></div>
                            <div><dt class="text-muted">Confiance de la détection</dt><dd class="mt-1">{{ technology.confidence is defined ? technology.confidence ~ ' %' : 'Inconnue' }}</dd></div>
                            <div><dt class="text-muted">Qualification du support</dt><dd class="mt-1">{{ {known:'Confirmée',estimated:'Estimée',unknown:'Inconnue'}[technology.supportStatus|default('unknown')]|default('Inconnue') }}{% if technology.supportConfidence is defined %} · {{ technology.supportConfidence }} %{% endif %}</dd></div>
                            <div><dt class="text-muted">Précision des dates</dt><dd class="mt-1">{{ technology.supportDatePrecision|default('') == 'month' ? 'Au mois (date affichée en fin de mois)' : (technology.supportDatePrecision|default('') == 'day' ? 'Au jour' : 'Inconnue') }}</dd></div>
                            <div class="min-w-0 sm:col-span-2"><dt class="text-muted">Source du support</dt><dd class="mt-1 [overflow-wrap:anywhere]">{{ technology.supportSource|default('Indisponible',true) }}</dd></div>
                            <div class="min-w-0 sm:col-span-2"><dt class="text-muted">Vérification du support</dt><dd class="mt-1">{{ technology.supportVerifiedAt|default('Non vérifiée',true) }}</dd></div>
                        </dl>
                    </article>
                {% else %}
                    <p class="text-sm text-muted">Aucune technologie détectée. La couverture de l’analyse ne permet pas d’en déduire une absence de technologie hors support.</p>
                {% endfor %}
            </div>
            <div class="exo-section-heading mt-7"><h2>Dépendances</h2></div>
            <div class="exo-table-scroll overflow-x-auto" role="region" aria-label="Tableau · Dépendances" tabindex="0">
                <table class="w-full text-left text-sm">
                    <thead><tr><th class="p-3">Package</th><th class="p-3">Déclarée</th><th class="p-3">Résolue</th><th class="p-3">Disponible / compatible</th><th class="p-3">Type / provenance</th></tr></thead>
                    <tbody>
                        {% for dependency in scan.results.dependencies|default([]) %}
                            <tr class="border-t border-line">
                                <td class="p-3"><span class="font-semibold">{{ dependency.name }}</span>{% if dependency.updateType|default(null) %}<span class="mt-2 block text-xs text-warning">{{ {major:'Mise à jour majeure',minor:'Mise à jour mineure',patch:'Correctif'}[dependency.updateType]|default(dependency.updateType) }}</span>{% endif %}</td>
                                <td class="p-3">{{ dependency.declared|default('Inconnue',true) }}</td>
                                <td class="p-3">{{ dependency.resolved|default('Inconnue',true) }}</td>
                                <td class="p-3">{{ dependency.latest|default('Indisponible',true) }} / {{ dependency.latestCompatible|default('Non vérifiée',true) }}</td>
                                <td class="p-3">{{ dependency.direct ? 'Directe' : 'Transitive' }} · {{ dependency.scope|default('Inconnu') }}<span class="mt-2 block text-xs text-muted">{{ dependency.source|default('Indisponible') }} · {{ dependency.verifiedAt|default('Non vérifiée',true) }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="p-4 text-muted">Aucune dépendance détectée. Consultez la couverture de l’analyse.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% for error in scan.results.errors|default([]) %}<p class="mt-4 rounded-lg border border-line p-3 text-sm text-warning">{{ error }}</p>{% endfor %}
        {% else %}
            <p class="text-muted">Aucune analyse disponible. Les versions, dates de support et risques restent à qualifier.</p>
        {% endif %}
    </section>
{% endblock %}
