{% extends 'base.html.twig' %}
{% block title %}Dépendances{% endblock %}
{% block page_title %}Dépendances · {{ repository.name }}{% endblock %}
{% block body %}
<section class="exo-card p-5">
<h2 class="mb-4 font-bold">Technologies et versions détectées</h2>
{% if scan %}
{% for technology in scan.results.technologies|default([]) %}
<p class="border-t border-line py-3">{{ technology.name|default(technology.technology|default('Technologie')) }} · Déclarée : {{ technology.declared|default('Inconnue',true) }} · Résolue : {{ technology.resolved|default('Inconnue',true) }}</p>
<dl class="mb-4 grid gap-2 text-sm sm:grid-cols-2">
    <div><dt class="text-muted">Fin de maintenance active</dt><dd>{{ technology.endOfMaintenance|default('Inconnue',true) }}</dd></div>
    <div><dt class="text-muted">Fin de support</dt><dd>{{ technology.eol|default('Inconnue',true) }}</dd></div>
    <div><dt class="text-muted">Source du support</dt><dd>{{ technology.supportSource|default('Indisponible',true) }}</dd></div>
    <div><dt class="text-muted">Vérification du support</dt><dd>{{ technology.supportVerifiedAt|default('Non vérifiée',true) }}</dd></div>
</dl>
{% else %}
<p class="text-muted">Aucune technologie détectée.</p>
{% endfor %}
<h2 class="mt-6 mb-4 font-bold">Dépendances</h2>
<div class="overflow-x-auto">
<table class="w-full text-left text-sm">
<thead>
<tr>
<th class="p-3">Package</th>
<th class="p-3">Déclarée</th>
<th class="p-3">Résolue</th>
<th class="p-3">Disponible / compatible</th>
<th class="p-3">Type / provenance</th>
</tr>
</thead>
<tbody>
{% for dependency in scan.results.dependencies|default([]) %}
<tr class="border-t border-line">
<td class="p-3">{{ dependency.name }}</td>
<td class="p-3">{{ dependency.declared|default('Inconnue',true) }}</td>
<td class="p-3">{{ dependency.resolved|default('Inconnue',true) }}</td>
<td class="p-3">{{ dependency.latest|default('Indisponible',true) }} / {{ dependency.latestCompatible|default('Non vérifiée',true) }}</td>
<td class="p-3">{{ dependency.direct ? 'Directe' : 'Transitive' }} · {{ dependency.scope|default('Inconnu') }}<span class="block text-xs text-muted">{{ dependency.source|default('Indisponible') }} · {{ dependency.verifiedAt|default('Non vérifiée',true) }}</span>
</td>
</tr>
{% else %}
<tr>
<td colspan="5" class="p-4 text-muted">Aucune dépendance détectée. Consultez la couverture de l’analyse.</td>
</tr>
{% endfor %}</tbody>
</table>
</div>
{% for error in scan.results.errors|default([]) %}
<p class="mt-4 text-warning">{{ error }}</p>
{% endfor %}
{% else %}
<p class="text-muted">Aucune analyse disponible.</p>
{% endif %}</section>
{% endblock %}
