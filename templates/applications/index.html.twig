{% extends 'base.html.twig' %}
{% block title %}Applications{% endblock %}
{% block page_title %}Applications et API{% endblock %}
{% block page_subtitle %}Retrouvez vos applications, leurs versions et les actions à prioriser.{% endblock %}
{% block body %}
<section class="exo-card p-5">
<div class="exo-section-heading"><h2>Votre parc applicatif</h2></div>
<form data-controller="filter" data-action="input->filter#queue change->filter#change submit->filter#cancel" data-turbo-frame="applications-results" method="get" class="exo-filter-bar mb-5" role="search" aria-label="Rechercher une application">
<div>
<label for="q" class="block text-sm">Rechercher</label>
<input class="exo-input" id="q" name="q" type="search" value="{{ q }}" placeholder="Rechercher par nom…">
</div>
<div>
<label for="status" class="block text-sm">État</label>
<select class="exo-input" id="status" name="status">
{% for value,label in {'':'Tous',healthy:'En bonne santé',attention:'À surveiller',critical:'Critiques',unknown:'Non évalués ou périmés',stale:'À actualiser'} %}
<option value="{{ value }}"{% if status == value %} selected{% endif %}>{{ label }}</option>
{% endfor %}</select>
</div>
<div>
<label for="connection" class="block text-sm">Connexion</label>
<select class="exo-input" id="connection" name="connection">
<option value="">Toutes les connexions</option>
{% for item in connections %}
<option value="{{ item.id }}"{% if connection|default('') == item.id %} selected{% endif %}>{{ item.name }}</option>
{% endfor %}
</select>
</div>
<div>
<label for="sort" class="block text-sm">Trier par</label>
<select class="exo-input" id="sort" name="sort">
{% for value,label in {name:'Nom',score:'Score',recent:'Dernière analyse'} %}
<option value="{{ value }}"{% if sort == value %} selected{% endif %}>{{ label }}</option>
{% endfor %}</select>
</div>
<button class="exo-btn" data-turbo-submits-with="Recherche…">Filtrer</button>
</form>

<turbo-frame id="applications-results" data-turbo-action="advance">
<div class="mb-4 flex flex-wrap items-center justify-between gap-3"><p class="text-sm text-muted">{{ total }} application(s) correspondent à votre recherche.</p>{% if q or status or connection|default('') %}<a class="text-sm text-primary underline" data-turbo-frame="_top" href="{{ path('app_applications') }}">Réinitialiser les filtres</a>{% endif %}</div>
{% include 'components/repositories.html.twig' %}{% include 'components/pagination.html.twig' %}</turbo-frame></section>
{% endblock %}
