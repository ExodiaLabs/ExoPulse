{% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('app_issues_preview') }}">
<input type="hidden" name="_token" value="{{ csrf_token('issue-preview') }}">{% endif %}
{% for finding in findings %}
<article class="border-t border-line py-4">
<label class="flex items-start gap-3">
{% if is_granted('ROLE_ADMIN') %}<input type="checkbox" name="findings[]" value="{{ finding.id }}" class="mt-1">{% endif %}
<span>
<strong>{{ finding.title }}</strong>
<span class="mt-1 block text-sm text-muted">{{ finding.repository.name }} · {{ finding.type }} · {{ finding.severity }}</span>
</span>
</label>
<dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
<div>
<dt class="text-muted">Version actuelle → cible</dt>
<dd>{{ finding.details.current|default('Inconnue',true) }} → {{ finding.details.target|default('À vérifier',true) }}</dd>
</div>
<div>
<dt class="text-muted">Première détection</dt>
<dd>{{ finding.firstSeenAt ? finding.firstSeenAt|date('d/m/Y') : 'Inconnue' }}</dd>
</div>
{% if finding.details.eol|default(null) %}
<div>
<dt class="text-muted">Fin de support</dt>
<dd>{{ finding.details.eol }}</dd>
</div>
{% endif %}
<div>
<dt class="text-muted">Source / vérification</dt>
<dd>{{ finding.details.source|default('Indisponible',true) }} · {{ finding.details.verifiedAt|default('Non vérifiée',true) }}</dd>
</div>
</dl>
</article>
{% else %}
<p class="py-4 text-sm text-muted">Aucun constat disponible. Une absence de constat ne garantit pas l’absence de risque.</p>
{% endfor %}
{% if findings|length and is_granted('ROLE_ADMIN') %}
<p class="my-3 text-sm text-muted">Sélectionnez les constats d’une même application. Aucune issue ne sera créée avant confirmation.</p>
<button class="exo-btn">Prévisualiser une issue</button>
{% endif %}{% if is_granted('ROLE_ADMIN') %}</form>{% endif %}
