<div class="exo-table-scroll overflow-x-auto" role="region" aria-label="Tableau · Applications" tabindex="0">
<table class="w-full text-left text-sm">
<thead class="text-muted">
<tr>
<th class="p-3">Application</th>
<th class="p-3">Connexion</th>
<th class="p-3">Score de santé</th>
<th class="p-3">Obsolescence / risque</th>
<th class="p-3">Confiance / couverture</th>
<th class="p-3">Dernière analyse</th>
</tr>
</thead>
<tbody>
{% for repository in repositories %}
<tr class="border-t border-line">
<td class="p-3">
<a class="font-bold text-primary underline" data-turbo-frame="_top" href="{{ path('app_application', {id:repository.id}) }}">{{ repository.name }}</a>
{% if repository.archived %}<span class="block text-xs text-muted">Archivé</span>
{% endif %}
{% if not repository.accessible %}<span class="block text-xs text-danger">Inaccessible</span>
{% endif %}</td>
<td class="p-3">{{ repository.connection.name }}</td>
<td class="p-3">
{% include 'components/score.html.twig' with {score:repository.latestScore,stale:analysis_is_stale(repository.lastScanAt)} only %}</td>
<td class="p-3">{% include 'components/technical_diagnostic.html.twig' with {diagnostic:diagnostics[repository.id]|default(null),compact:true} only %}</td>
<td class="p-3">{{ repository.confidence }} % / {{ repository.coverage }} %</td>
<td class="p-3">{{ repository.lastScanAt ? repository.lastScanAt|date('d/m/Y H:i') : 'Jamais analysé' }}</td>
</tr>
{% else %}
<tr>
<td colspan="6" class="p-6 text-muted">Aucune application ne correspond aux critères.</td>
</tr>
{% endfor %}</tbody>
</table>
</div>
