{% if pages > 1 %}<nav class="mt-5 flex flex-wrap gap-3" aria-label="Pagination">{% for number in 1..pages %}<a class="exo-btn exo-btn-alt" href="{{ path(app.current_route, app.request.query.all|merge({page: number})) }}"{% if number == page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}</nav>{% endif %}