{% extends 'base.html.twig' %}
{% block title %}Alertes{% endblock %}
{% block page_title %}Alertes et recommandations{% endblock %}
{% block body %}
<section class="exo-card p-5">
<form method="get" class="mb-5 flex flex-wrap items-end gap-3">
<div>
<label for="q">Recherche</label>
<input class="exo-input" id="q" name="q" value="{{ q }}">
</div>
<div>
<label for="severity">Sévérité</label>
<select class="exo-input" name="severity" id="severity">
{% for value,label in {'':'Toutes',critical:'Critique',warning:'Avertissement',info:'Information'} %}
<option value="{{ value }}"{% if severity == value %} selected{% endif %}>{{ label }}</option>
{% endfor %}</select>
</div>
<div>
<label for="type">Type</label>
<input class="exo-input" name="type" id="type" value="{{ type }}">
</div>
<button class="exo-btn">Filtrer</button>
</form>
<p class="mb-3 text-sm text-muted">{{ total }} constat(s)</p>
{% include 'components/findings.html.twig' %}{% include 'components/pagination.html.twig' %}</section>
{% endblock %}
