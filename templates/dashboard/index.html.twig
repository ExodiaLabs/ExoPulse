{% extends 'base.html.twig' %}
{% block title %}Tableau de bord{% endblock %}
{% block page_subtitle %}Vue d’ensemble de la santé technique du parc applicatif{% endblock %}
{% block body %}
    <p class="mb-6 text-xs text-muted">Aucune analyse disponible · Aucun score calculé</p>
    <section class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-5" aria-label="Indicateurs du parc">
        {% for label in ['Applications', 'En bonne santé', 'À surveiller', 'Critiques', 'Dépendances obsolètes'] %}
            <article class="exo-card p-5">
                <h2 class="exo-eyebrow">{{ label }}</h2>
                <p class="mt-2 text-3xl font-bold" aria-label="Non disponible">—</p>
                <p class="mt-1 text-xs text-muted">En attente d’analyse</p>
            </article>
        {% endfor %}
    </section>
    <section class="exo-card p-5" aria-label="Premiers pas">
        {% include 'components/empty_state.html.twig' with {
            title: 'Votre parc attend sa première analyse',
            message: 'Aucun repository n’a encore été synchronisé. Les indicateurs de santé, technologies et priorités apparaîtront lorsque des résultats vérifiés seront disponibles.'
        } only %}
        <p class="pb-4 text-center text-sm text-muted">La configuration des fournisseurs et les analyses seront disponibles dans les prochains incréments.</p>
    </section>
    <section class="mt-5 grid gap-4 lg:grid-cols-3" aria-label="Résultats des analyses">
        {% for heading in ['Santé du parc', 'Technologies principales', 'Versions hors support'] %}
            <article class="exo-card p-5">
                <h2 class="font-bold">{{ heading }}</h2>
                <p class="mt-5 text-sm text-muted">Informations indisponibles avant la première analyse.</p>
            </article>
        {% endfor %}
    </section>
{% endblock %}
